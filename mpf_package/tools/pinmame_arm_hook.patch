diff --git a/src/cpu/arm7/arm7.c b/src/cpu/arm7/arm7.c
index b39fbbd..ac079b4 100644
--- a/src/cpu/arm7/arm7.c
+++ b/src/cpu/arm7/arm7.c
@@ -106,6 +106,7 @@ void arm7_exit(void)
 	/* nothing to do here */
 }
 
+static void (*pinmame_arm_hook)(unsigned int pc, unsigned int *regs) = 0;
 int arm7_execute( int cycles )
 {
 /*include the arm7 core execute code*/
diff --git a/src/cpu/arm7/arm7exec.c b/src/cpu/arm7/arm7exec.c
index 2f569a1..f9fafba 100644
--- a/src/cpu/arm7/arm7exec.c
+++ b/src/cpu/arm7/arm7exec.c
@@ -162,6 +162,9 @@ extern unsigned at91_get_reg(int regnum);
 
 		/* load 32 bit instruction, trying the JIT first */
 		pc = R15;
+#ifdef ARM_TRACE_HOOK
+		if (pinmame_arm_hook) { pinmame_arm_hook(pc, &ARM7.sArmRegister[0]); pc = R15; }
+#endif
 
 #ifdef PINMAME_JIT_ASMJIT
 		// asmjit JIT: run translated code if available for this PC, otherwise fall through
@@ -169,7 +172,7 @@ extern unsigned at91_get_reg(int regnum);
 		// with chaining, a whole run of cached blocks without returning here between them
 		// -- mutates the register file in place, charges ARM7_ICOUNT itself, and returns
 		// the resume PC
-		if (ARM7.ajit)
+		if (ARM7.ajit && !pinmame_arm_hook)
 		{
 			uint32_t aj_newpc;
 			if (arm7_aj_run((ArmAsmjitCtl *)ARM7.ajit, &ARM7.sArmRegister[0], pc, arm7_aj_fetch, &aj_newpc))
@@ -190,7 +193,7 @@ extern unsigned at91_get_reg(int regnum);
 
 		// Helpful to backtrace a crash :)
 
-		JIT_FETCH(ARM7.jit, pc);
+		if (!pinmame_arm_hook) { JIT_FETCH(ARM7.jit, pc); }
 		insn = cpu_readop32(pc);
 		op_offset = 0;
 
diff --git a/src/cpu/at91/at91.c b/src/cpu/at91/at91.c
index f55400e..903a09b 100644
--- a/src/cpu/at91/at91.c
+++ b/src/cpu/at91/at91.c
@@ -1705,6 +1705,12 @@ void at91_exit(void)
 	arm7_core_exit();
 }
 
+void (*pinmame_arm_hook)(unsigned int pc, unsigned int *regs) = 0;
+unsigned int pinmame_arm_read32(unsigned int a) { return READ32(a); }
+unsigned int pinmame_arm_read8(unsigned int a) { return READ8(a); }
+void pinmame_arm_write32(unsigned int a, unsigned int d) { WRITE32(a,d); }
+void pinmame_arm_write8(unsigned int a, unsigned int d) { WRITE8(a,d); }
+#define ARM_TRACE_HOOK 1
 int at91_execute( int cycles )
 {
 	/*include the arm7 core execute code*/
diff --git a/src/libpinmame/libpinmame.cpp b/src/libpinmame/libpinmame.cpp
index 8dc1181..cf90edd 100644
--- a/src/libpinmame/libpinmame.cpp
+++ b/src/libpinmame/libpinmame.cpp
@@ -3310,3 +3310,18 @@ PINMAMEAPI void PinmameSetMemMap(uint8_t* platform, size_t platformSize, uint8_t
 		libpinmame_log_error("PinmameSetMemMap(): failed to parse memory map: %s", e.what());
 	}
 }
+
+extern "C" {
+extern void (*pinmame_arm_hook)(unsigned int pc, unsigned int *regs);
+unsigned int pinmame_arm_read32(unsigned int a);
+unsigned int pinmame_arm_read8(unsigned int a);
+void pinmame_arm_write32(unsigned int a, unsigned int d);
+void pinmame_arm_write8(unsigned int a, unsigned int d);
+__attribute__((visibility("default"))) void PinmameSetArmHook(void (*h)(unsigned int, unsigned int*)) { pinmame_arm_hook = h; }
+__attribute__((visibility("default"))) unsigned int PinmameArmRead32(unsigned int a) { return pinmame_arm_read32(a); }
+__attribute__((visibility("default"))) unsigned int PinmameArmRead8(unsigned int a) { return pinmame_arm_read8(a); }
+__attribute__((visibility("default"))) void PinmameArmWrite32(unsigned int a, unsigned int d) { pinmame_arm_write32(a,d); }
+__attribute__((visibility("default"))) void PinmameArmWrite8(unsigned int a, unsigned int d) { pinmame_arm_write8(a,d); }
+}
+extern "C" double timer_get_time(void);
+extern "C" __attribute__((visibility("default"))) double PinmameEmuTime() { return timer_get_time(); }
